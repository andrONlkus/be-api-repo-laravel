APP_NAME=be-api-repo
APP_TIMEZONE=Asia/Jakarta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Database arsip DMS (tabel lama, tidak dimigrasi)
DB_DMS_HOST=127.0.0.1
DB_DMS_PORT=3306
DB_DMS_DATABASE=db_dms
DB_DMS_USERNAME=
DB_DMS_PASSWORD=

# Folder file arsip. Server: /mnt/ossfs/arsip (mount Alibaba OSS)
ARSIP_PATH=/mnt/ossfs/arsip
ARSIP_ALLOWED_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx,ppt,pptx
# API key antar server, format key:nama-app,key2:nama-app2
# Buat key: php -r 'echo bin2hex(random_bytes(20));'
ARSIP_API_KEYS=
ARSIP_DEFAULT_USER=819
# Awalan URL download di ListOfFiles endpoint lama (kosong = URL aplikasi ini)
ARSIP_LEGACY_BASE_URL=
